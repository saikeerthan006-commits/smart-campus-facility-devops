# Smart Campus Facility Platform Environment Configuration (Template)
# Copy to .env for local overrides. Never commit real secrets to version control.
APP_SECRET_KEY=replace-with-strong-32-byte-hmac-secret
DATABASE_URL=sqlite:///./campus_platform.db
TEST_DB_PASSWORD=replace-with-isolated-test-db-password
EXTERNAL_SYNC_FAIL=false
APP_VERSION=v1.0.0
SIMULATE_BROKEN_RELEASE=false
